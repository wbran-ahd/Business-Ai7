# Environment files: real values stay local, only the template is tracked.
.env
.env.*
!.env.example
node_modules
dist
# This project installs with bun (bun.lock is tracked). yarn.lock is a stray
# leftover and would pin a third, stale dependency set if it were committed.
yarn.lock
.vercel
# Vendored Vercel CLI that only the local preview script uses.
.vercel-vendor/
# Local dev/preview logs and generated PWA leftovers.
*.log
# AI Studio scratch pastes (e.g. the original master system prompt) are
# build-time inputs, not app assets. Nothing references them and they would
# otherwise be served publicly from the site root.
public/assets/aistudio/
# Generated by scripts/build-jwt.* — encoded tokens and decoded claim dumps
# (they carry claim data/PII). Regenerate locally; never commit them.
scripts/jwt-token.txt
scripts/jwt-payload.json
scripts/jwt-verify.txt
